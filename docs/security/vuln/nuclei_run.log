dding:24px 20px 40px; }\n  h1 { font-size:20px; margin:0 0 4px; } .sub { color:var(--mute); margin:0 0 20px; font-size:14px; }\n  .hero { display:flex; gap:20px; align-items:stretch; flex-wrap:wrap; }\n  .badge { flex:1 1 320px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:22px;\n           display:flex; flex-direction:column; justify-content:center; }\n  .state { font-size:44px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; }\n  .why { color:var(--mute); margin-top:6px; min-height:48px; }\n  .layers { flex:2 1 520px; display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }\n  .layer { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:18px; }\n  .layer h2 { margin:0; font-size:13px; font-weight:600; color:var(--mute); text-transform:uppercase; letter-spacing:.8px; }\n  .light { display:flex; align-items:center; gap:10px; margin-top:10px; font-size:20px; font-weight:600; }\n  .dot { width:16px; height:16px; border-radius:50%; background:#475073; }\n  .dot.ok { background:var(--up); box-shadow:0 0 12px var(--up); } .dot.bad { background:var(--down); box-shadow:0 0 12px var(--down); }\n  .dot.skip { background:#475073; }\n  .detail { color:var(--mute); font-size:13px; margin-top:6px; min-height:36px; }\n  .strip { margin-top:20px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 18px; }\n  .strip h2 { margin:0 0 10px; font-size:13px; font-weight:600; color:var(--mute); text-transform:uppercase; letter-spacing:.8px; }\n  .cells { display:flex; gap:3px; flex-wrap:nowrap; overflow:hidden; }\n  .cell { flex:0 0 14px; height:34px; border-radius:3px; }\n  .legend { display:flex; gap:16px; flex-wrap:wrap; margin-top:10px; color:var(--mute); font-size:13px; }\n  .legend span::before { content:\"\"; display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; background:var(--c); }\n  #caption { position:fixed; left:0; right:0; bottom:0; padding:16px 24px; background:rgba(5,8,20,.92); color:#fff;\n             font-size:22px; text-align:center; display:none; border-top:1px solid var(--line); }\n  .s-up{color:var(--up)} .s-degraded{color:var(--degraded)} .s-blocked{color:var(--blocked)} .s-tunnel_down{color:var(--down)}\n  .c-up{background:var(--up)} .c-degraded{background:var(--degraded)} .c-blocked{background:var(--blocked)} .c-tunnel_down{background:var(--down)}\n\u003c/style\u003e\n\u003c/head\u003e\n\u003cbody\u003e\n\u003cmain\u003e\n  \u003ch1\u003eCamera fleet lab\u003c/h1\u003e\n  \u003cp class=\"sub\" id=\"who\" style=\"display:none\"\u003e\u003c/p\u003e\n  \u003cp class=\"sub\"\u003eOne camera behind a site router, reachable only through a WireGuard tunnel. Probed every few seconds, layer by layer.\u003c/p\u003e\n  \u003cdiv class=\"hero\"\u003e\n    \u003cdiv class=\"badge\"\u003e\u003cdiv class=\"state\" id=\"state\"\u003e...\u003c/div\u003e\u003cdiv class=\"why\" id=\"why\"\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003cdiv class=\"layers\"\u003e\n      \u003cdiv class=\"layer\"\u003e\u003ch2\u003e1 \u0026middot; Tunnel\u003c/h2\u003e\u003cdiv class=\"light\"\u003e\u003cspan class=\"dot\" id=\"d-tunnel\"\u003e\u003c/span\u003e\u003cspan id=\"t-tunnel\"\u003e...\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"detail\" id=\"x-tunnel\"\u003e\u003c/div\u003e\u003c/div\u003e\n      \u003cdiv class=\"layer\"\u003e\u003ch2\u003e2 \u0026middot; Port (NAT)\u003c/h2\u003e\u003cdiv class=\"light\"\u003e\u003cspan class=\"dot\" id=\"d-tcp\"\u003e\u003c/span\u003e\u003cspan id=\"t-tcp\"\u003e...\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"detail\" id=\"x-tcp\"\u003e\u003c/div\u003e\u003c/div\u003e\n      \u003cdiv class=\"layer\"\u003e\u003ch2\u003e3 \u0026middot; Video\u003c/h2\u003e\u003cdiv class=\"light\"\u003e\u003cspan class=\"dot\" id=\"d-rtsp\"\u003e\u003c/span\u003e\u003cspan id=\"t-rtsp\"\u003e...\u003c/span\u003e\u003c/div\u003e\n        \u003cdiv class=\"detail\" id=\"x-rtsp\"\u003e\u003c/div\u003e\u003c/div\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cdiv class=\"strip\"\u003e\u003ch2\u003eLast 60 probes, oldest left\u003c/h2\u003e\u003cdiv class=\"cells\" id=\"cells\"\u003e\u003c/div\u003e\n    \u003cdiv class=\"legend\"\u003e\u003cspan style=\"--c:var(--up)\"\u003eup\u003c/span\u003e\u003cspan style=\"--c:var(--degraded)\"\u003edegraded: port answers, no video\u003c/span\u003e\n      \u003cspan style=\"--c:var(--blocked)\"\u003eblocked: VPN fine, port not forwarded\u003c/span\u003e\u003cspan style=\"--c:var(--down)\"\u003etunnel down: no packet crosses the VPN\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e\n\u003c/main\u003e\n\u003cdiv id=\"caption\"\u003e\u003c/div\u003e\n\u003cscript\u003e\nconst WHY = {\n  up: \"Video decodes through the tunnel.\",\n  degraded: \"The port answers but no video decodes. A camera or encoder problem, not the network.\",\n  blocked: \"Packets cross the VPN, the camera port does not answer. Look at the NAT rule, the firewall, the camera.\",\n  tunnel_down: \"No packet crosses the VPN. Look at WireGuard, the keys, the endpoint, the 4G link.\"\n};\nconst $ = id =\u003e document.getElementById(id);\nfunction light(prefix, ok, skipped, text, detail) {\n  $(\"d-\" + prefix).className = \"dot \" + (skipped ? \"skip\" : ok ? \"ok\" : \"bad\");\n  // a layer that was not checked has nothing to explain: showing the upstream error under it reads as a second failure\n  $(\"t-\" + prefix).textContent = text; $(\"x-\" + prefix).textContent = skipped ? \"\" : (detail || \"\");\n}\nasync function tick() {\n  try {\n    const [s, h] = await Promise.all([fetch(\"/status\").then(r =\u003e r.json()), fetch(\"/history?limit=60\").then(r =\u003e r.json())]);\n    const st = $(\"state\"); st.textContent = s.state.replace(\"_\", \" \"); st.className = \"state s-\" + s.state;\n    $(\"why\").textContent = WHY[s.state] || \"\";\n    light(\"tunnel\", s.tunnel_ok, false, s.tunnel_ok