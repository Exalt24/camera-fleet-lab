ing:24px 20px 40px; }\n  h1 { font-size:20px; margin:0 0 4px; } .sub { color:var(--mute); margin:0 0 20px; font-size:14px; }\n  .hero { display:flex; gap:20px; align-items:stretch; flex-wrap:wrap; }\n  .badge { flex:1 1 320px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:22px;\n           display:flex; flex-direction:column; justify-content:center; }\n  .state { font-size:44px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; }\n  .why { color:var(--mute); margin-top:6px; min-height:48px; }\n  .layers { flex:2 1 520px; display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }\n  .layer { background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:18px; }\n  .layer h2 { margin:0; font-size:13px; font-weight:600; color:var(--mute); text-transform:uppercase; letter-spacing:.8px; }\n  .light { display:flex; align-items:center; gap:10px; margin-top:10px; font-size:20px; font-weight:600; }\n  .dot { width:16px; height:16px; border-radius:50%; background:#475073; }\n  .dot.ok { background:var(--up); box-shadow:0 0 12px var(--up); } .dot.bad { background:var(--down); box-shadow:0 0 12px var(--down); }\n  .dot.skip { background:#475073; }\n  .detail { color:var(--mute); font-size:13px; margin-top:6px; min-height:36px; }\n  .strip { margin-top:20px; background:var(--panel); border:1px solid var(--line); border-radius:14px; padding:16px 18px; }\n  .strip h2 { margin:0 0 10px; font-size:13px; font-weight:600; color:var(--mute); text-transform:uppercase; letter-spacing:.8px; }\n  .cells { display:flex; gap:3px; flex-wrap:nowrap; overflow:hidden; }\n  .cell { flex:0 0 14px; height:34px; border-radius:3px; }\n  .legend { display:flex; gap:16px; flex-wrap:wrap; margin-top:10px; color:var(--mute); font-size:13px; }\n  .legend span::before { content:\"\"; display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:6px; background:var(--c); }\n  #caption { position:fixed; left:0; right: